"""
Disk image build configuration.
"""

import os
import shutil
import subprocess
from pathlib import Path

from SCons.Action import Action
from SCons.Environment import Environment
from SCons.Script import Flatten

from scripts.scons.utility import GlobRecursive
from scripts.scons.disk import (
    VolumeLabel,
    CreateBootableIso,
    GenerateGrubConfig,
)

Import("UserLibraries")
Import("UserApplications")
Import("TargetEnvironment")

TargetEnvironment: Environment
BuildEnvironment: Environment = TargetEnvironment


def IterateBootloaderComponentNodes(Components: dict):
    for ComponentName, Component in Components.items():
        if hasattr(Component, "get_abspath"):
            yield ComponentName, Component
            continue

        for Item in Flatten([Component]):
            if not hasattr(Item, "get_abspath"):
                continue
            ItemName = f"{ComponentName}:{os.path.basename(str(Item))}"
            yield ItemName, Item


def ResolveComponentPaths(Components: dict) -> tuple[dict, set]:
    """Resolve component dict nodes to absolute paths and a set of their string representations."""
    Paths = {}
    StringSet = set()
    for ComponentName, Component in IterateBootloaderComponentNodes(Components):
        AbsolutePath = Component.get_abspath()
        Paths[ComponentName] = AbsolutePath
        StringSet.add(str(Component))
        StringSet.add(AbsolutePath)
    return Paths, StringSet


def ResolveNodePaths(Nodes: list) -> tuple[list, set]:
    """Resolve a flat list of SCons nodes to absolute paths and a set of their string representations."""
    Paths = []
    StringSet = set()
    for Node in Flatten(Nodes):
        AbsolutePath = (
            Node.get_abspath() if hasattr(Node, "get_abspath") else str(Node)
        )
        Paths.append(AbsolutePath)
        StringSet.add(str(Node))
    return Paths, StringSet


def StageSysroot(Stage: str, Compiler: str) -> None:
    """Copy the compiler's sysroot into the staging directory."""
    try:
        RuntimeSysroot = subprocess.check_output(
            [Compiler, "-print-sysroot"], text=True
        ).strip()
    except Exception:
        RuntimeSysroot = ""

    if not RuntimeSysroot or not os.path.isdir(RuntimeSysroot):
        print("   (sysroot not available, skipping sysroot staging)")
        return

    print(f"   STAGE SYSROOT -> {RuntimeSysroot}")

    AllItems = list(Path(RuntimeSysroot).rglob("*"))
    for Item in AllItems:
        if Item.is_dir():
            os.makedirs(
                os.path.join(Stage, Item.relative_to(RuntimeSysroot)), exist_ok=True
            )
        elif Item.is_file() or Item.is_symlink():
            DestinationFile = os.path.join(Stage, Item.relative_to(RuntimeSysroot))
            os.makedirs(os.path.dirname(DestinationFile), exist_ok=True)
            shutil.copy2(str(Item), DestinationFile, follow_symlinks=False)


def StageBootloaderLibraries(
    BootloaderComponents: dict, BootDirectory: str
) -> None:
    """Copy bootloader libraries into the boot directory."""
    Libraries = [
        ComponentPath
        for Name, ComponentPath in BootloaderComponents.items()
        if Name.startswith("Main:")
    ]
    for LibraryPath in sorted(set(Libraries)):
        print(f"   STAGE {os.path.basename(LibraryPath)} -> /boot")
        shutil.copy2(LibraryPath, BootDirectory)


def BuildDisk(
    ImagePath,
    KernelComponents,
    KernelName,
    Libraries,
    Applications,
    ExtraFiles,
    BootloaderComponents,
    EnvironmentObject,
):
    Architecture = EnvironmentObject.get("BuildArch", "i686")
    BootType = EnvironmentObject.get("BootType", "bios")
    BootSystem = EnvironmentObject.get("BootSystem", "grub")

    BuildTag = f"{Architecture}_{EnvironmentObject['BuildConfig']}"
    Stage = EnvironmentObject.get(
        "ImageStagingDirectory", os.path.join("build", BuildTag, "img")
    )

    if os.path.isdir(Stage):
        shutil.rmtree(Stage)
    elif os.path.exists(Stage):
        os.remove(Stage)
    os.makedirs(Stage, exist_ok=True)
    print(f"   STAGE -> {Stage}")

    # Stage compiler sysroot
    StageSysroot(Stage, EnvironmentObject.subst("$CC"))

    # Stage kernel to /boot
    BootDirectory = os.path.join(Stage, "boot")
    os.makedirs(BootDirectory, exist_ok=True)

    if KernelComponents:
        for ComponentPath in KernelComponents.values():
            print(f"   STAGE {os.path.basename(ComponentPath)} -> /boot")
            shutil.copy2(ComponentPath, BootDirectory)

    # Stage bootloader libraries to /boot
    if BootloaderComponents:
        StageBootloaderLibraries(BootloaderComponents, BootDirectory)

    # Generate GRUB config with the actual kernel filename
    GenerateGrubConfig(
        os.path.join(BootDirectory, "grub"),
        Config=EnvironmentObject["BuildConfig"],
        KernelName=KernelName,
        VolumeLabelName=VolumeLabel,
    )

    # Stage user libraries
    if Libraries:
        LibraryDirectory = os.path.join(Stage, "usr", "lib")
        os.makedirs(LibraryDirectory, exist_ok=True)
        for Library in Libraries:
            print(f"   STAGE {os.path.basename(Library)} -> /usr/lib")
            shutil.copy2(Library, LibraryDirectory)

    # Stage user applications
    if Applications:
        BinaryDirectory = os.path.join(Stage, "usr", "bin")
        os.makedirs(BinaryDirectory, exist_ok=True)
        for Application in Applications:
            print(f"   STAGE {os.path.basename(Application)} -> /usr/bin")
            shutil.copy2(Application, BinaryDirectory)

    # Stage extra files (root filesystem)
    SourceRoot = EnvironmentObject["BASEDIR"]
    for Node in ExtraFiles:
        Source = Node.srcnode().path
        Relative = os.path.relpath(Source, SourceRoot)
        Destination = os.path.join(Stage, Relative)
        if os.path.isdir(Source):
            os.makedirs(Destination, exist_ok=True)
        else:
            print(f"   STAGE {Relative}")
            os.makedirs(os.path.dirname(Destination), exist_ok=True)
            shutil.copy2(Source, Destination)

    CreateBootableIso(
        Stage,
        ImagePath,
        VolumeLabel,
        Architecture=Architecture,
        BootType=BootType,
        BootSystem=BootSystem,
        BootloaderComponents=BootloaderComponents,
    )


def BuildImageAction(*_Args, **KeywordArguments):
    Target = KeywordArguments["target"]
    Source = KeywordArguments["source"]
    EnvironmentObject = KeywordArguments["env"]

    # Resolve kernel components to paths
    KernelComponentPaths, KernelComponentSet = ResolveComponentPaths(
        EnvironmentObject.get("KernelComponents", {})
    )

    # Derive kernel name from the first kernel component's actual filename
    if KernelComponentPaths:
        FirstComponent = next(iter(KernelComponentPaths.values()))
        KernelName = os.path.basename(FirstComponent)
    else:
        KernelName = "valeciumx"

    # Resolve library and application paths
    LibraryPaths, LibrarySet = ResolveNodePaths(UserLibraries)
    ApplicationPaths, ApplicationSet = ResolveNodePaths(UserApplications)

    # Resolve bootloader component paths
    BootloaderComponentPaths, BootloaderComponentSet = ResolveComponentPaths(
        EnvironmentObject.get("BootloaderComponents", {})
    )

    # Determine extra files (source files not claimed by any component)
    ExtraFiles = [
        SourceNode
        for SourceNode in Source
        if str(SourceNode) not in KernelComponentSet
        and str(SourceNode) not in LibrarySet
        and str(SourceNode) not in ApplicationSet
        and str(SourceNode) not in BootloaderComponentSet
    ]

    BuildDisk(
        str(Target[0]),
        KernelComponentPaths,
        KernelName,
        LibraryPaths,
        ApplicationPaths,
        ExtraFiles,
        BootloaderComponentPaths,
        EnvironmentObject,
    )


Root = BuildEnvironment.Dir("root")
RootFiles = GlobRecursive(BuildEnvironment, "*", Root)

BootloaderInputs = []
if BuildEnvironment.get("BootType", "grub") in ("bios", "efi"):
    for _, Component in IterateBootloaderComponentNodes(
        BuildEnvironment.get("BootloaderComponents", {})
    ):
        BootloaderInputs.append(Component)

KernelInputs = []
for _, Component in IterateBootloaderComponentNodes(
    BuildEnvironment.get("KernelComponents", {})
):
    KernelInputs.append(Component)

Inputs = KernelInputs + UserLibraries + UserApplications + RootFiles + BootloaderInputs

Output = f"valeciumos-{BuildEnvironment['ProjVersion']}_{BuildEnvironment['BuildConfig']}_{BuildEnvironment['BuildArch']}.iso"

Image = BuildEnvironment.Command(
    Output,
    Inputs,
    action=Action(BuildImageAction, "   CREATING ISO"),
    BASEDIR=Root.srcnode().path,
)

Export("Image")
